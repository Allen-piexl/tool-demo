# Required for real external API calls
RAPIDAPI_KEY=your_rapidapi_key_here

# Qwen3:8B via Ollama. For simple local demo, all primitives can share one Ollama server.
STOCK_OLLAMA_BASE_URL=http://localhost:11434
NEWS_OLLAMA_BASE_URL=http://localhost:11434
AMAZON_OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# Primitive service ports
STOCK_PORT=8001
NEWS_PORT=8002
AMAZON_PORT=8003
KIWI_PORT=8010
