# Required for real external API calls
RAPIDAPI_KEY=your_rapidapi_key_here

# Qwen3:8B via Ollama. For simple local demo, all primitives can share one Ollama server.
STOCK_OLLAMA_BASE_URL=http://localhost:11434
NEWS_OLLAMA_BASE_URL=http://localhost:11434
AMAZON_OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# Primitive service ports
# The router is a public unified endpoint that selects one primitive for a user message.
ROUTER_PORT=8000
# These stay publicly accessible and are now served by lightweight on-demand gateways.
STOCK_PORT=8001
NEWS_PORT=8002
AMAZON_PORT=8003
KIWI_PORT=8010

# Private worker ports bound to 127.0.0.1 and started only after a request arrives.
STOCK_WORKER_PORT=18001
NEWS_WORKER_PORT=18002
AMAZON_WORKER_PORT=18003
KIWI_WORKER_PORT=18010

# On-demand lifecycle settings
# Stateless workers stop after this many idle seconds.
PRIMITIVE_IDLE_TIMEOUT_SECONDS=300
# Kiwi remains alive while sessions are active; a session expires after this inactivity period.
KIWI_SESSION_IDLE_TIMEOUT_SECONDS=1800
PRIMITIVE_STARTUP_TIMEOUT_SECONDS=30

# Optional router overrides
ROUTER_OLLAMA_BASE_URL=http://localhost:11434
ROUTER_OLLAMA_MODEL=qwen3:8b
ROUTER_TIMEOUT_SECONDS=120
ROUTER_PRIMITIVE_TIMEOUT_SECONDS=180
